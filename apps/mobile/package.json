{
  "name": "@cproviderprices/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "lint": "eslint .",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"vitest.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:expo-config": "expo config --type public",
    "export:check": "expo export --platform android --output-dir .expo-export-check"
  },
  "dependencies": {
    "@cproviderprices/design-tokens": "0.1.0",
    "@cproviderprices/generated-api-client": "0.1.0",
    "@cproviderprices/i18n": "0.1.0",
    "expo": "~55.0.31",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "vitest": "^3.2.4"
  }
}
