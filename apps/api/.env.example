APP_NAME=CProviderPrices
IMPORT_MAX_KIB=10240
IMPORT_NORMALIZATION_BATCH_ROWS=25
INGESTION_SERVICE_URL=http://ingestion:8001
INGESTION_SERVICE_TIMEOUT=20
# Share a privately generated secret with ingestion; never commit the real value.
INGESTION_SERVICE_TOKEN=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# JSON is the default structured operational format. Set text only for local diagnosis.
LOG_FORMAT=json

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cproviderprices
DB_USERNAME=cproviderprices
DB_PASSWORD=local-postgres-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Native bearer tokens expire independently from browser sessions; never set a raw token here.
MOBILE_ACCESS_TOKEN_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Keep empty locally. Production must list only known reverse-proxy IP/CIDR values.
TRUSTED_PROXIES=
# Optional comma-separated Laravel trusted-host regular expressions; APP_URL is always trusted.
TRUSTED_HOSTS=
# Enable only after HTTPS is configured by deployment; never enable for localhost HTTP.
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=cproviderprices

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="local@cproviderprices.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=cproviderprices-local
AWS_SECRET_ACCESS_KEY=local-minio-password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cproviderprices-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
