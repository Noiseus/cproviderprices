{
	email {$ACME_EMAIL}
	admin off
}

(common_security) {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

http://{$APP_HOST}, http://{$API_HOST} {
	redir https://{host}{uri} permanent
}

https://{$APP_HOST} {
	import common_security

	@api path /api/v1/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

https://{$API_HOST} {
	import common_security
	reverse_proxy api:8080
}
