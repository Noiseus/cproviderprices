# Copy outside Git as /etc/cproviderprices/staging.env and replace every REPLACE value.
APP_NAME=CProviderPrices
APP_ENV=staging
APP_KEY=base64:REPLACE_WITH_A_DISTINCT_STAGING_KEY
APP_DEBUG=false
APP_MAINTENANCE_DRIVER=cache
LOG_LEVEL=info

IMAGE_TAG=REPLACE_WITH_IMMUTABLE_GIT_SHA
WEB_IMAGE=registry.example/cproviderprices/web
API_IMAGE=registry.example/cproviderprices/api
INGESTION_IMAGE=registry.example/cproviderprices/ingestion
POSTGRES_IMAGE=registry.example/cproviderprices/postgres
CADDY_IMAGE=caddy:2.8.4-alpine

ACME_EMAIL=ops@example.invalid
APP_HOST=app-staging.cproviderprices.com
API_HOST=api-staging.cproviderprices.com
WEB_URL=https://app-staging.cproviderprices.com
APP_URL=https://api-staging.cproviderprices.com
FRONTEND_URL=https://app-staging.cproviderprices.com
CORS_ALLOWED_ORIGINS=https://app-staging.cproviderprices.com
SESSION_COOKIE=cproviderprices_staging_session
# Sibling staging hostnames share this parent; the cookie name/key/database remain staging-only.
SESSION_DOMAIN=.cproviderprices.com
TRUSTED_HOSTS=^app-staging\.cproviderprices\.com$,^api-staging\.cproviderprices\.com$
APPLICATION_NETWORK_SUBNET=172.29.0.0/24
CADDY_APPLICATION_IP=172.29.0.2

POSTGRES_DB=cproviderprices_staging
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_STAGING_POSTGRES_ADMIN_PASSWORD
APP_DB_USERNAME=cproviderprices_staging_app
APP_DB_PASSWORD=REPLACE_WITH_DISTINCT_STAGING_APP_DATABASE_PASSWORD
DB_SSLMODE=prefer

REDIS_PASSWORD=REPLACE_WITH_DISTINCT_STAGING_REDIS_PASSWORD
REDIS_PREFIX=cproviderprices_staging_database_
CACHE_PREFIX=cproviderprices_staging

MINIO_ROOT_USER=cproviderprices-staging-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_DISTINCT_STAGING_MINIO_ADMIN_PASSWORD
MINIO_BUCKET=cproviderprices-staging-private
AWS_ACCESS_KEY_ID=cproviderprices-staging-app
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_DISTINCT_STAGING_MINIO_APP_SECRET

INGESTION_SERVICE_TOKEN=REPLACE_WITH_DISTINCT_STAGING_INGESTION_TOKEN
# Non-secret, positive whole-day lifetime. Mobile access tokens are revocable.
MOBILE_ACCESS_TOKEN_TTL_DAYS=30

# Configure the selected SMTP provider; Mailpit is never part of this topology.
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_STAGING_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_STAGING_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply-staging@example.invalid
MAIL_FROM_NAME=CProviderPrices Staging
